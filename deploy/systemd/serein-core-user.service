[Unit]
Description=SereinOS Core Service (User Instance)
Documentation=https://github.com/serein-ai/serein-os
After=graphical-session.target dbus.socket
Wants=dbus.socket

[Service]
Type=notify
ExecStart=/usr/local/bin/serein-core --user
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30

# User service security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

# Resource limits for user service
LimitNOFILE=32768
LimitNPROC=2048
MemoryMax=1G
CPUQuota=100%

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=serein-core-user

[Install]
WantedBy=graphical-session.target