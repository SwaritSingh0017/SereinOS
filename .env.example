# Example SereinOS Configuration
# Copy this to .env and fill in your values

# NVIDIA API (get yours at https://build.nvidia.com/explore/discover)
NVIDIA_API_KEY=

# OpenRouter (optional - for smart tier fallback)
OPENROUTER_API_KEY=

# Azure Speech (optional - for voice)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Ollama (optional - for local models)
OLLAMA_BASE_URL=http://localhost:11434